# ==============================================================================
# ELECZZA 2.0 - Environment Configuration
# ==============================================================================

# Authentication & Access Control
# Restricts registrations and logins to authorized institutional email domains
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=@aot.edu.in

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Express backend and optional local mock responses
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MOCK_API=false
# Set to true only when apiRequest callers pass a typed mock response.

# Supabase Public API (Client & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Private / Server Key (Admin operations, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
